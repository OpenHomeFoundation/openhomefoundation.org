---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_URL, DEFAULT_DESCRIPTION } from "../lib/site";
// Swiper's core CSS is global on purpose: besides the carousels, several
// pages (documents, supporters) reuse .swiper-slide for card layout.
import "swiper/css";
import "../styles/style.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Site-relative canonical URL, e.g. "/blog/". */
  canonicalUrl?: string;
  /** Crossposts: canonicalises to the source article. */
  externalUrl?: string;
  ogImage?: string;
  authorDisplay?: string | null;
  category?: string;
  /** Reading time in minutes; only blog posts pass this. */
  readingTime?: number;
}

const { title, description, noindex, canonicalUrl, externalUrl, ogImage, authorDisplay, category, readingTime } =
  Astro.props;

const fullTitle = title ? `${title} – Open Home Foundation` : "Open Home Foundation";
const fullDescription = description || DEFAULT_DESCRIPTION;

const og = ogImage || "/assets/images/opengraph.jpg";
const ogImageUrl = og.includes("://") ? og : `${SITE_URL}${og}`;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{fullTitle}</title>
    <meta name="description" content={fullDescription} />
    <meta name="viewport" content="width=device-width" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonicalUrl && <link rel="canonical" href={`${SITE_URL}${canonicalUrl}`} />}
    {externalUrl && <link rel="canonical" href={externalUrl} />}
    {/* Send the full crosspost URL (path included) as the referrer to the source, not just the origin. */}
    {externalUrl && <meta name="referrer" content="no-referrer-when-downgrade" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:image" content={ogImageUrl} />
    {authorDisplay && <meta property="og:image:author" content={authorDisplay} />}
    {category && <meta property="og:image:category" content={category} />}
    {readingTime && (
      <>
        <meta name="twitter:label1" value="Reading time" />
        <meta name="twitter:data1" value={`~${readingTime} ${readingTime === 1 ? "minute" : "minutes"}`} />
      </>
    )}
    {authorDisplay && (
      <>
        <meta name="twitter:label2" value="Written by" />
        <meta name="twitter:data2" value={authorDisplay} />
      </>
    )}
    <link rel="alternate" type="application/atom+xml" title="Open Home Foundation Blog" href="/blog/feed.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="icon" type="image/png" href="/favicon-dark-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon-dark-32x32.png" sizes="32x32" />

    <!-- Light mode favicon -->
    <link
      rel="icon"
      href="/favicon-16x16.png"
      type="image/x-icon"
      media="(prefers-color-scheme: light)"
      sizes="16x16"
    />
    <link
      rel="icon"
      href="/favicon-32x32.png"
      type="image/x-icon"
      media="(prefers-color-scheme: light)"
      sizes="32x32"
    />

    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&display=swap" rel="stylesheet" />

    {/* Plausible via the shared loader (src/pages/plausible.js.ts) — the same
        script every OHF site embeds. It resolves this site's Plausible script
        id from list/plausible-sites.json and replaces any referrer not on
        list/allowed-referrers.txt, so visitors' private Home Assistant and
        ESPHome URLs are never recorded. Root-relative on purpose: dev,
        previews, and production all exercise the script they serve. */}
    <script is:inline async src="/plausible.js?site=openhomefoundation.org"></script>
    <script>
      import "../scripts/nav-menu.js";
      import "../scripts/copy-email.js";
      import "../scripts/code-copy.js";
      import "../scripts/animate-on-scroll.js";
    </script>
    <slot name="head" />
  </head>
  <body>
    <header><Navbar /></header>
    <div class="content"><slot /></div>
    <footer><Footer /></footer>
  </body>
</html>
