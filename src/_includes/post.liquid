---
layout: base
---
<div class="bg-gradient-blog">
  <section id="news-header">
    <div class="container">
      <div class="grid">
        <div class="column col-s-12 col-m-10 col-m-offset-2">
          <h1 class="text-center mb-48">
            {{ title }}
          </h1>
          {% if description %}
            <p class="text-center">
              {{ description }}
            </p>
          {% endif %}
          {% if author %}
            <p class="meta text-center">
              <span class="meta-secondary">{{ date | date: '%A, %B %d, %Y' }} · {{ reading_time }} minute read</span>
              <span class="meta-author"
                ><span class="author-avatars">
                  {%- for slug in author -%}
                    {%- assign a = authors[slug] -%}
                    {%- if a.github -%}
                      <img class="author-avatar" src="https://github.com/{{ a.github }}.png?size=80" alt="{{ a.name }}">
                    {%- elsif a.avatar -%}
                      <img class="author-avatar" src="{{ a.avatar }}" alt="{{ a.name }}">
                    {%- endif -%}
                  {%- endfor -%}</span
                ><span class="author-names">
                  {%- for slug in author -%}
                    {%- assign a = authors[slug] -%}
                    {%- if a -%}
                      {%- if a.github -%}
                        <a href="https://github.com/{{ a.github }}" target="_blank" rel="noopener noreferrer">
                          {{- a.name -}}
                        </a>
                      {%- else -%}
                        {{- a.name -}}
                      {%- endif -%}
                    {%- else -%}
                      {{- slug -}}
                    {%- endif -%}
                    {%- unless forloop.last %}, {% endunless -%}
                  {%- endfor -%}
                </span></span
              >
            </p>
          {% else %}
            <p class="meta text-center">
              <span class="meta-secondary">{{ date | date: '%A, %B %d, %Y' }} · {{ reading_time }} minute read</span>
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</div>
<div class="bg-primary">
  <section id="post">
    <div class="container">
      {% if og_image and hide_header_image != true %}
        <div class="header">
          <img
            class="header-image"
            src="{{ og_image }}"
            alt="{{ title }}"
          >
        </div>
      {% endif %}
      <div class="grid">
        <div class="col-s-12 col-m-8 col-m-offset-3">
          <article class="post content{% unless comments == true and env.isProduction %} mb-128{% endunless %}">
            {{ content }}
            {% if external_url %}
              <p class="mt-24">
                <a href="{{ external_url }}" class="button">Read the full article on {{ external_source }}</a>
              </p>
            {% endif %}
          </article>
          {% if external_url %}
            <script>
              // Crosspost: page is indexed and canonicalised to the source, then
              // sends readers straight to the original article.
              window.location.replace("{{ external_url }}");
            </script>
          {% endif %}
          {% if comments == true and env.isProduction %}
            <div id="discourse-comments" class="mb-128"></div>
            <script type="text/javascript">
              DiscourseEmbed = {
                discourseUrl: 'https://community.home-assistant.io/',
                discourseEmbedUrl: 'https://www.openhomefoundation.org{{ page.url }}',
              };

              (function () {
                var d = document.createElement('script');
                d.type = 'text/javascript';
                d.async = true;
                d.src = DiscourseEmbed.discourseUrl + 'javascripts/embed.js';
                (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(d);
              })();
            </script>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</div>
