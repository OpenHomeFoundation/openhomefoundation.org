<div class="navbar-container">
  <div class="navbar">
    <div class="navbar-bar">
      <a href="/" class="logo-link">
        <img
          class="logo"
          src="/assets/images/logo/open-home-foundation.svg"
          alt="Open Home Foundation"
        >
      </a>
      <ul class="menu">
        <li class="menu-item has-dropdown {% if page.url == '/about/' or page.url == '/structure/' or page.url == '/supporters/' %}active{% endif %}">
          <a href="#" aria-haspopup="true">Who we are<span class="dropdown-arrow" aria-hidden="true"></span></a>
          <ul class="dropdown">
            <li class="{% if page.url == '/about/' %}active{% endif %}"><a href="/about/">Our story</a></li>
            <li class="{% if page.url == '/structure/' %}active{% endif %}"><a href="/structure/">Structure</a></li>
            <li class="{% if page.url == '/supporters/' %}active{% endif %}"><a href="/supporters/">Supporters</a></li>
          </ul>
        </li>
        <li class="menu-item has-dropdown {% if page.url == '/projects/' or page.url == '/research/' %}active{% endif %}">
          <a href="#" aria-haspopup="true">What we do<span class="dropdown-arrow" aria-hidden="true"></span></a>
          <ul class="dropdown">
            <li class="{% if page.url == '/projects/' %}active{% endif %}"><a href="/projects/">Projects</a></li>
            <li class="{% if page.url == '/research/' %}active{% endif %}"><a href="/research/">Research *</a></li>
            <li class="{% if page.url == '/research/' %}active{% endif %}"><a href="/research/">Advocacy *</a></li>
          </ul>
        </li>

        <li class="menu-item has-dropdown {% if page.url == '/documents/' or page.url == '/press-kit/' %}active{% endif %}">
          <a href="#" aria-haspopup="true">Resources<span class="dropdown-arrow" aria-hidden="true"></span></a>
          <ul class="dropdown">
            <li class="{% if page.url == '/documents/' %}active{% endif %}">
              <a href="/documents/">Privacy whitepaper *</a>
            </li>
            <li class="{% if page.url == '/documents/' %}active{% endif %}"><a href="/documents/">Documents</a></li>
            <li class="{% if page.url == '/press-kit/' %}active{% endif %}"><a href="/press-kit/">Press kit *</a></li>
          </ul>
        </li>

        <li class="menu-item {% if page.url contains '/blog/' %}active{% endif %}"><a href="/blog/">News</a></li>
        <li class="menu-item">
          <a href="https://store.openhomefoundation.org/" target="_blank">Store</a>
        </li>
      </ul>
      <a href="/structure/#support-our-work" class="button">Support us</a>
      <button
        class="menu-button"
        id="navbar-menu-button"
        aria-haspopup="true"
        aria-controls="navbar-menu"
        aria-label="Toggle menu"
      >
        {% include 'svg/menu.svg' %}
      </button>
    </div>
    <ul class="navbar-menu" id="navbar-menu" role="menu" aria-labelledby="navbar-menu-button">
      <li class="navbar-menu-item has-dropdown {% if page.url == '/about/' or page.url == '/structure/' or page.url == '/supporters/' %}active{% endif %}">
        <details
          {% if page.url == '/about/' or page.url == '/structure/' or page.url == '/supporters/' %}
            open
          {% endif %}
        >
          <summary>Who we are<span class="dropdown-arrow" aria-hidden="true"></span></summary>
          <ul class="dropdown">
            <li class="{% if page.url == '/about/' %}active{% endif %}"><a href="/about/">Our story</a></li>
            <li class="{% if page.url == '/structure/' %}active{% endif %}"><a href="/structure/">Structure</a></li>
            <li class="{% if page.url == '/supporters/' %}active{% endif %}"><a href="/supporters/">Supporters</a></li>
          </ul>
        </details>
      </li>
      <li class="navbar-menu-item has-dropdown {% if page.url == '/projects/' or page.url == '/research/' %}active{% endif %}">
        <details
          {% if page.url == '/projects/' or page.url == '/research/' %}
            open
          {% endif %}
        >
          <summary>What we do<span class="dropdown-arrow" aria-hidden="true"></span></summary>
          <ul class="dropdown">
            <li class="{% if page.url == '/projects/' %}active{% endif %}"><a href="/projects/">Projects</a></li>
            <li class="{% if page.url == '/research/' %}active{% endif %}"><a href="/research/">Research *</a></li>
            <li class="{% if page.url == '/research/' %}active{% endif %}"><a href="/research/">Advocacy *</a></li>
          </ul>
        </details>
      </li>
      <li class="navbar-menu-item has-dropdown {% if page.url == '/documents/' or page.url == '/press-kit/' %}active{% endif %}">
        <details
          {% if page.url == '/documents/' or page.url == '/press-kit/' %}
            open
          {% endif %}
        >
          <summary>Resources<span class="dropdown-arrow" aria-hidden="true"></span></summary>
          <ul class="dropdown">
            <li class="{% if page.url == '/documents/' %}active{% endif %}">
              <a href="/documents/">Privacy whitepaper *</a>
            </li>
            <li class="{% if page.url == '/documents/' %}active{% endif %}"><a href="/documents/">Documents</a></li>
            <li class="{% if page.url == '/press-kit/' %}active{% endif %}"><a href="/press-kit/">Press kit *</a></li>
          </ul>
        </details>
      </li>
      <li class="navbar-menu-item {% if page.url contains '/blog/' %}active{% endif %}">
        <a href="/blog/">News</a>
      </li>
      <li class="navbar-menu-item">
        <a href="https://store.openhomefoundation.org/" target="_blank">Store</a>
      </li>
      <li class="navbar-menu-item">
        <a href="/structure/#support-our-work">Support us</a>
      </li>
    </ul>
  </div>
</div>
