{% capture full_title -%}
{%- if title -%}
{{ title }} – Open Home Foundation
{%- else -%}
Open Home Foundation
{%- endif-%}
{%- endcapture %}

{% capture full_description -%}
{%- if description -%}
{{ description }}
{%- else -%}
The Open Home Foundation fights for the principles of privacy, choice, and sustainability for smart homes. And for every
person who lives in one. It does this by supporting the development of open source projects, and open connectivity and
communication standards.
{%- endif-%}

{%- endcapture %}

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ full_title }}</title>
    <meta name="description" content="{{ full_description }}">
    <meta name="viewport" content="width=device-width">
    {%- if noindex %}
      <meta name="robots" content="noindex">
    {%- endif %}
    <meta property="og:title" content="{{ full_title }}">
    <meta property="og:description" content="{{ full_description }}">
    {%- capture og_image_url -%}
      {%- assign _og = og_image | default: '/assets/images/opengraph.jpg' -%}
      {%- if _og contains '://' -%}{{ _og }}{%- else -%}https://www.openhomefoundation.org{{ _og }}{%- endif -%}
    {%- endcapture -%}
    <meta
      property="og:image"
      content="{{ og_image_url }}"
    >
    {%- if author_display %}
      <meta property="og:image:author" content="{{ author_display }}">
    {%- endif %}
    {%- if category %}
      <meta property="og:image:category" content="{{ category }}">
    {%- endif %}
    {%- if reading_time and layout == 'post' %}
      <meta name="twitter:label1" value="Reading time">
      <meta
        name="twitter:data1"
        value="~{{ reading_time }} {% if reading_time == 1 %}minute{% else %}minutes{% endif %}"
      >
    {%- endif %}
    {%- if author_display %}
      <meta name="twitter:label2" value="Written by">
      <meta name="twitter:data2" value="{{ author_display }}">
    {%- endif %}
    <link rel="alternate" type="application/atom+xml" title="Open Home Foundation Blog" href="/blog/feed.xml">
    <link rel="stylesheet" href="/assets/swiper-bundle.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link rel="icon" type="image/png" href="/favicon-dark-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="/favicon-dark-32x32.png" sizes="32x32">

    <!-- Light mode favicon -->
    <link
      rel="icon"
      href="/favicon-16x16.png"
      type="image/x-icon"
      media="(prefers-color-scheme: light)"
      sizes="16x16"
    >
    <link
      rel="icon"
      href="/favicon-32x32.png"
      type="image/x-icon"
      media="(prefers-color-scheme: light)"
      sizes="32x32"
    >

    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&display=swap" rel="stylesheet">
    <script src="/assets/js/nav-menu.js" defer></script>
    <script src="/assets/js/copy-email.js" defer></script>
    <script src="/assets/js/code-copy.js" defer></script>

    <script async src="https://plausible.openhomefoundation.org/js/pa-M8_u5edrDOz5Ui2iONt2_.js"></script>
    <script>
      // Visitors arriving from their own Home Assistant or ESPHome instance send
      // their private URL as the referrer. Anything not on the allowlist is
      // replaced before Plausible ever sees it, so those URLs are never
      // recorded. Source of truth: list/allowed-referrers.txt
      var OHF_ALLOWED_REFERRERS = {{ allowedReferrers.json }};

      (window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        }),
        (plausible.init =
          plausible.init ||
          function (i) {
            plausible.o = i || {};
          });
      plausible.init({
        transformRequest: function (payload) {
          var ref = payload.r;
          if (!ref) return payload;

          var host = "";
          try {
            host = new URL(ref).hostname.replace(/\.$/, "");
          } catch (e) {
            // Unparseable referrer: falls through and gets replaced.
          }

          for (var i = 0; i < OHF_ALLOWED_REFERRERS.length; i++) {
            var d = OHF_ALLOWED_REFERRERS[i];
            if (
              host === d ||
              (host.length > d.length && host.slice(-(d.length + 1)) === "." + d)
            ) {
              return payload;
            }
          }

          // One aggregate bucket in Plausible, so we can see how much we filter
          // without learning anything about individual visitors. .invalid is
          // reserved by RFC 2606 and can never collide with a real domain.
          payload.r = "https://unlisted.invalid/";
          return payload;
        },
      });
    </script>
  </head>
  <body>
    <header>{% include 'components/navbar' %}</header>
    <div class="content">{{ content }}</div>
    <footer>{% include 'components/footer' %}</footer>
  </body>
</html>
