---
layout: base
---
<div class="{% if hero == 'blue' %}bg-gradient-agreement-header{% else %}bg-gradient-paper-header{% endif %}">
  <section
    id="paper-header"
    {% if hero == 'blue' %}
      class="hero-light"
    {% endif %}
  >
    <div class="container">
      <div class="grid">
        <div class="column col-s-12 col-m-10 col-m-offset-2">
          {% if lead %}
            <p class="lead text-center">
              {{ lead }}
            </p>
          {% endif %}
          <h1 class="text-center mb-48">
            {{ title }}
          </h1>
          {% if description %}
            <p class="text-center">
              {{ description }}
            </p>
          {% endif %}
          {% if pdf %}
            <p class="text-center mt-32">
              <a
                href="{{ pdf }}"
                class="button {% if hero == 'blue' %}button-outline{% else %}button-outline-light{% endif %}"
                target="_blank"
                rel="noopener noreferrer"
              >
                Download PDF
                {% include 'svg/arrow_outward.svg' %}
              </a>
            </p>
          {% endif %}
          {% if article %}
            <p class="text-center mt-32">
              <a
                href="{{ article }}"
                class="button {% if hero == 'blue' %}button-outline{% else %}button-outline-light{% endif %}"
              >
                Read more
                {% include 'svg/arrow_outward.svg' %}
              </a>
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</div>
<div class="bg-primary">
  <section id="paper">
    <div class="container">
      <div class="grid">
        <div class="col-s-12 col-m-8 col-m-offset-3">
          <div class="content">
            {{ content }}
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
