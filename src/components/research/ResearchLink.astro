---
import Icon from "../Icon.astro";
import { isExternal } from "../../lib/research";

interface Props {
  href: string;
  class?: string;
  arrow?: boolean;
}

const { href, class: className, arrow = true } = Astro.props;
const external = isExternal(href);
---

<a
  href={href}
  class:list={["research-link", className]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot />{arrow && <Icon name={external ? "arrow_outward" : "arrow-forward-small"} />}{
    external && <span class="visually-hidden"> (opens in a new tab)</span>
  }
</a>
