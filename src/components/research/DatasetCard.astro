---
import Badge from "./Badge.astro";
import { isExternal } from "../../lib/research";

interface Props {
  title: string;
  text?: string;
  href: string;
  meta: string;
  badge: string;
  ours?: boolean;
}

const { title, text, href, meta, badge, ours = false } = Astro.props;
const external = isExternal(href);
---

<a
  href={href}
  class:list={["dataset-card", { ours }]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <Badge tone={ours ? "dark" : "default"}>{badge}</Badge>
  <h3>{title}</h3>
  {text && <p>{text}</p>}
  <p class="dataset-card-meta">{meta}</p>
</a>
