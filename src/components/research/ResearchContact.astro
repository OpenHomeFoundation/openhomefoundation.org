---
import { RESEARCH_EMAIL } from "../../lib/research-links";
---

<section class="research-contact" aria-labelledby="research-contact-title">
  <div class="container">
    <div class="research-contact-card">
      <div>
        <h2 id="research-contact-title">Questions about our research?</h2>
        <p>Get in touch with the research team.</p>
      </div>
      <a
        href={`mailto:${RESEARCH_EMAIL}`}
        class="button button-dark-blue research-email copy-email"
        aria-label="Contact the research team - click to copy email address">{RESEARCH_EMAIL}</a
      >
    </div>
  </div>
</section>
