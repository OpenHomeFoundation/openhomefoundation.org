---
import BlogCard from "./BlogCard.astro";
import BlogFilterBar from "./BlogFilterBar.astro";
import Icon from "./Icon.astro";
import { blogPageHref, buildPaginationNav, type BlogFacets, type BlogListing } from "../lib/blog";

interface Props {
  listing: BlogListing;
  facets: BlogFacets;
  title: string;
  description: string;
}

const { listing, facets, title, description } = Astro.props;
const { facet, posts, page: currentPage, totalPages } = listing;
const base = facet.href;
const paginationNav = buildPaginationNav(currentPage, totalPages, base);
---

<div class="bg-gradient-blog">
  <section id="news-header">
    <div class="container">
      <div class="grid">
        <div class="column col-s-12 col-m-10 col-m-offset-2">
          <h1 class="text-center mb-48">{title}</h1>
          <p class="text-center">{description}</p>
        </div>
      </div>
    </div>
  </section>
</div>
<div class="bg-primary">
  <section id="blog-list">
    <div class="container">
      <BlogFilterBar facets={facets} current={facet} />
      <div class="grid">
        {
          posts.map((post) => (
            <div class="col-s-12 col-m-6 col-l-4">
              <BlogCard post={post} />
            </div>
          ))
        }
      </div>
      {
        totalPages > 1 && (
          <nav class="pagination" aria-label="Blog pagination">
            {currentPage > 1 ? (
              <a
                href={blogPageHref(currentPage - 1, base)}
                class="pagination-arrow pagination-arrow-prev"
                aria-label="Previous page"
              >
                <Icon name="arrow" />
              </a>
            ) : (
              <span class="pagination-arrow pagination-arrow-prev is-disabled" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            )}

            <ul class="pagination-list">
              {paginationNav.map((item) => (
                <li>
                  {item.ellipsis ? (
                    <span class="pagination-ellipsis">&hellip;</span>
                  ) : (
                    <a
                      href={item.href}
                      class:list={["pagination-number", { "is-current": item.current }]}
                      aria-current={item.current ? "page" : undefined}
                    >
                      {item.number}
                    </a>
                  )}
                </li>
              ))}
            </ul>

            {currentPage < totalPages ? (
              <a href={blogPageHref(currentPage + 1, base)} class="pagination-arrow pagination-arrow-next" aria-label="Next page">
                <Icon name="arrow" />
              </a>
            ) : (
              <span class="pagination-arrow pagination-arrow-next is-disabled" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            )}
          </nav>
        )
      }
    </div>
  </section>
</div>
