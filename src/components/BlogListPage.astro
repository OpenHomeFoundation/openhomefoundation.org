---
import BlogCard from "./BlogCard.astro";
import BlogFilterBar from "./BlogFilterBar.astro";
import Icon from "./Icon.astro";
import { blogPageHref, buildPaginationNav, type BlogListing } from "../lib/blog";

interface Props {
  listing: BlogListing;
  showBreadcrumbs: boolean;
}

const { listing, showBreadcrumbs } = Astro.props;
const { base, heading, intro, breadcrumbs, posts, page: currentPage, totalPages, featured } = listing;
const paginationLists = [
  { variant: "wide", items: buildPaginationNav(currentPage, totalPages, base) },
  { variant: "compact", items: buildPaginationNav(currentPage, totalPages, base, true) },
];
---

<div class="bg-gradient-blog">
  <section id="news-header" class:list={["blog-listing-header", { "has-intro": intro }]}>
    <div class="container">
      <div class="grid">
        <div class="column col-s-12 col-m-10 col-m-offset-2">
          {
            showBreadcrumbs && (
              <nav class="blog-breadcrumbs" aria-label="Breadcrumb">
                <ol>
                  <li>
                    <a href="/">Home</a>
                  </li>
                  {breadcrumbs.map((crumb) => (
                    <li>
                      <svg viewBox="0 0 8 10" width="8" height="10" aria-hidden="true">
                        <path d="M0 0l8 5-8 5z" fill="currentColor" />
                      </svg>
                      <a href={crumb.href}>{crumb.name}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <h1 class="text-center">{heading}</h1>
          {intro && <p class="text-center">{intro}</p>}
        </div>
      </div>
    </div>
  </section>
</div>
<div class="bg-primary">
  <section id="blog-list">
    <div class="container">
      <BlogFilterBar listing={listing} />
      {featured && <BlogCard post={featured} featured />}
      <div class="grid">
        {
          posts.map((post) => (
            <div class="col-s-12 col-m-6 col-l-4">
              <BlogCard post={post} />
            </div>
          ))
        }
      </div>
      {
        totalPages > 1 && (
          <nav class="pagination" aria-label="Blog pagination">
            {currentPage > 1 ? (
              <a
                href={blogPageHref(currentPage - 1, base)}
                class="pagination-arrow pagination-arrow-prev"
                aria-label="Previous page"
              >
                <Icon name="arrow" />
              </a>
            ) : (
              <span class="pagination-arrow pagination-arrow-prev is-disabled" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            )}

            {paginationLists.map(({ variant, items }) => (
              <ul class={`pagination-list pagination-list-${variant}`}>
                {items.map((item) => (
                  <li>
                    {item.ellipsis ? (
                      <span class="pagination-ellipsis" aria-hidden="true">
                        &hellip;
                      </span>
                    ) : (
                      <a
                        href={item.href}
                        class:list={["pagination-number", { "is-current": item.current }]}
                        aria-current={item.current ? "page" : undefined}
                      >
                        {item.number}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            ))}

            {currentPage < totalPages ? (
              <a href={blogPageHref(currentPage + 1, base)} class="pagination-arrow pagination-arrow-next" aria-label="Next page">
                <Icon name="arrow" />
              </a>
            ) : (
              <span class="pagination-arrow pagination-arrow-next is-disabled" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            )}
          </nav>
        )
      }
    </div>
  </section>
</div>
