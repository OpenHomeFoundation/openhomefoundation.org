---
// Community Day social-asset generator: edit the meetup details and download
// the graphic. The image itself is rendered server-side — the form simply
// drives the query string of /community-day/asset-generator/image.png (see
// src/pages/community-day/asset-generator/image.png.ts), and the preview is a
// plain <img> pointing at that endpoint, so the page works before (and
// without) JavaScript.
//
// Ported from https://github.com/elcaptain/social-templates
// (Figma file 61SfzG7xiYlR5YUheV82F9).
import { TEMPLATES } from "../../lib/asset-templates.js";

const tpl = TEMPLATES[0];
const IMAGE_URL = "/community-day/asset-generator/image.png";
const defaultSize = tpl.sizes.find((s) => s.value === tpl.defaultSize);
---

<section class="asset-generator">
  <form class="panel" data-image-url={IMAGE_URL}>
    <h2>Content</h2>

    <label class="field">
      <span class="field-label">Size</span>
      <select name="size">
        {
          tpl.sizes.map((s) => (
            <option value={s.value} selected={s.value === tpl.defaultSize}>
              {s.label}
            </option>
          ))
        }
      </select>
    </label>

    <label class="field">
      <span class="field-label">Project logo</span>
      <select name="logo">
        {
          tpl.logos.map((l) => (
            <option value={l.value} selected={l.value === tpl.defaultLogo}>
              {l.label}
            </option>
          ))
        }
      </select>
    </label>

    <label class="field">
      <span class="field-label">{tpl.datePicker.label}</span>
      <input type="date" name="date" value={tpl.datePicker.default} />
    </label>

    {
      tpl.fields.map((f) => (
        <label class="field" data-field={f.name}>
          <span class="field-label">{f.label}</span>
          <input
            type="text"
            name={f.name}
            value={f.default}
            maxlength={f.maxLength}
          />
        </label>
      ))
    }

    <label class="toggle">
      <input type="checkbox" name="byline" checked={tpl.byline.default} />
      <span>{tpl.byline.label}</span>
    </label>

    <div class="actions">
      <a class="download" href={`${IMAGE_URL}?download=1`} data-download
        >Download PNG</a
      >
      <span data-status role="status"></span>
    </div>
  </form>

  <div class="panel preview">
    <h2>Preview</h2>
    <img
      src={IMAGE_URL}
      width={tpl.width}
      height={defaultSize.height}
      alt={`Preview of the ${tpl.name} graphic`}
      data-preview
    />
  </div>
</section>

<script>
  // Rebuild the endpoint URL from the form and swap the preview/download
  // targets, debounced so typing a city doesn't fire a render per keystroke.
  const form = document.querySelector<HTMLFormElement>(".asset-generator form");
  const preview = document.querySelector<HTMLImageElement>("[data-preview]");
  const download = document.querySelector<HTMLAnchorElement>("[data-download]");
  const status = document.querySelector<HTMLElement>("[data-status]");

  if (form && preview && download && status) {
    const imageUrl = form.dataset.imageUrl!;

    const currentUrl = () => {
      const data = new FormData(form);
      const params = new URLSearchParams();
      for (const name of ["size", "logo", "date", "city", "organizer"]) {
        const value = data.get(name);
        if (typeof value === "string" && value) params.set(name, value);
      }
      params.set("byline", data.get("byline") ? "1" : "0");
      return `${imageUrl}?${params}`;
    };

    const apply = () => {
      const url = currentUrl();
      status.textContent = "Rendering…";
      preview.src = url;
      download.href = `${url}&download=1`;
    };
    preview.addEventListener("load", () => (status.textContent = ""));
    preview.addEventListener(
      "error",
      () => (status.textContent = "Rendering failed — try again."),
    );

    let timer: ReturnType<typeof setTimeout>;
    form.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(apply, 400);
    });
    form.addEventListener("submit", (e) => e.preventDefault());
  }
</script>

<style lang="scss">
  .asset-generator {
    --ag-title: #002332;
    --ag-muted: #4f606e;
    --ag-accent: #41d09b;
    --ag-border: #e3e7ea;

    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1.75rem;
    align-items: start;

    @media (max-width: 840px) {
      grid-template-columns: 1fr;
    }
  }

  .panel {
    background: #ffffff;
    border: 1px solid var(--ag-border);
    border-radius: 1.5rem;
    padding: 1.5rem;

    h2 {
      margin: 0 0 1rem;
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ag-muted);
    }
  }

  .field {
    display: block;
    margin-bottom: 1rem;
  }
  .field-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
    color: var(--ag-title);
  }
  .field input,
  .field select {
    width: 100%;
    padding: 10px 12px;
    font: inherit;
    font-size: 0.9375rem;
    border: 1px solid var(--ag-border);
    border-radius: 0.5rem;
    outline: none;
    background: #ffffff;

    &:focus {
      border-color: var(--ag-accent);
      box-shadow: 0 0 0 3px rgba(65, 208, 155, 0.25);
    }
  }

  .toggle {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0.25rem 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ag-title);
    cursor: pointer;
    user-select: none;

    input {
      width: 17px;
      height: 17px;
      accent-color: var(--ag-accent);
      cursor: pointer;
    }
  }

  .actions {
    margin-top: 1.375rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .download {
    background: var(--ag-accent);
    color: var(--ag-title);
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.75rem 1.375rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition:
      background-color 150ms ease-in-out,
      color 150ms ease-in-out;

    &:hover {
      background-color: var(--ag-title);
      color: #ffffff;
    }
  }
  [data-status] {
    font-size: 0.8125rem;
    color: var(--ag-muted);
  }

  .preview img {
    display: block;
    width: 100%;
    max-width: 540px;
    height: auto;
    border-radius: 0.5rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }
</style>
