---
import Section from "./Section.astro";
---

<Section id="ready-to-join">
  <div class="inner">
    <div class="title-container">
      <h2 class="h2 heading">Ready to join?</h2>

      <div class="content-container">
        <div class="button-container">
          <a href="/" class="button button--secondary button--has-icon button--find">Find an event near you</a>
          <a href="/" class="button button--secondary button--has-icon button--host">Host a meetup</a>
          <a href="/" class="button button--secondary button--has-icon button--discord">Join the host Discord channel</a>
          <a href="/" class="button button--secondary button--has-icon button--contact">Get in touch</a>
        </div>
      </div>
    </div>
  </div>
</Section>

<style lang="scss">
  .inner {
    @include fluid(32px, 80px, $property: padding);
  }

  .title-container {
    @include fluid(32px, 48px, $property: gap);
  }
</style>