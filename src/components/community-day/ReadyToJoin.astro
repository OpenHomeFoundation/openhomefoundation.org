---
import Section from "./Section.astro";
---

<Section id="ready-to-join">
  <div class="inner">
    <div class="title-container animate--fade-up-in">
      <h2 class="h2 heading">Ready to join?</h2>

      <div class="content-container">
        <div class="button-container">
          <a href="#find-a-meetup" class="button button--secondary button--has-icon button--find">Find an event near you</a>
          <a href="https://luma.com/communityday2026" target="_blank" rel="noopener noreferrer" class="button button--secondary button--has-icon button--host">Host a meetup</a>
          <a href="https://www.home-assistant.io/join-chat" target="_blank" rel="noopener noreferrer" class="button button--secondary button--has-icon button--discord">Join the host Discord channel</a>
          <a href="mailto:community@openhomefoundation.org" class="button button--secondary button--has-icon button--contact copy-email">Get in touch</a>
        </div>
      </div>
    </div>
  </div>
</Section>

<style lang="scss">
  .inner {
    @include fluid(32px, 80px, $property: padding);
  }

  .title-container {
    @include fluid(32px, 48px, $property: gap);
  }
</style>