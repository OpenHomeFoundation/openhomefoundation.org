---
import Icon from "./Icon.astro";
---

<div class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-header">
        <a href="/" aria-label="Open Home Foundation" class="logo">
          <Icon name="open-home-foundation-logo" />
        </a>
        <ul>
          <li>
            <a href="/documents/">Documents</a>
          </li>
          <li>
            <a href="/media-room/">Media room</a>
          </li>
          <li>
            <a href="/user-research-agreement/">User research agreement</a>
          </li>
          <li>
            <a href="/structure/#support-our-work">Support us</a>
          </li>
          <li>
            <a href="/privacy-policy/">Privacy Policy</a>
          </li>
          <li>
            <a href="/impressum/">Impressum</a>
          </li>
          <li>
            <a href="https://jobs.ashbyhq.com/openhomefoundation/" target="_blank">Jobs</a>
          </li>
        </ul>
      </div>
      <div class="footer-actions">
        <div class="footer-action">
          <p>Contact us</p>
          <a
            href="mailto:hello@openhomefoundation.org"
            class="button button-outline contact-us copy-email"
            aria-label="Get in touch - click to copy email address"
            >hello@openhomefoundation.org</a
          >
        </div>
        <div class="footer-action">
          <p>Follow us</p>
          <div class="social-links">
            <a
              aria-label="View Open Home Foundation on GitHub"
              href="https://github.com/openhomefoundation"
              target="_blank"
              rel="noopener noreferrer"
              class="button button-icon button-outline"
            >
              <Icon name="github" />
            </a>
            <a
              aria-label="View Open Home Foundation on Mastodon"
              href="https://fosstodon.org/@openhomefoundation"
              target="_blank"
              rel="noopener noreferrer"
              class="button button-icon button-outline"
            >
              <Icon name="mastodon" />
            </a>
            <a
              aria-label="View Open Home Foundation on Bluesky"
              href="https://bsky.app/profile/openhomefoundation.org"
              target="_blank"
              rel="noopener noreferrer"
              class="button button-icon button-outline"
            >
              <Icon name="bluesky" />
            </a>
          </div>
        </div>
        <div class="footer-action">
          <p>Subscribe to the newsletter</p>
          <a
            href="https://newsletter.openhomefoundation.org/#/portal/signup"
            target="_blank"
            rel="noopener noreferrer"
            class="button button-outline"
          >
            <Icon name="inbox" />
            Subscribe
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>Copyright © Open Home Foundation</p>
        <div>
          This website uses <a
            href="https://www.openhomefoundation.org/blog/making-our-web-analytics-open-source-with-plausible/"
            rel="noopener">privacy-first analytics</a
          > to help us improve the site. You can view all data in our <a
            href="https://plausible.openhomefoundation.org/openhomefoundation.org"
            rel="noopener">public dashboard</a
          >.
        </div>
        <p><strong>Open Home Foundation</strong> | CHE-416.988.952</p>
      </div>
    </div>
  </div>
</div>
