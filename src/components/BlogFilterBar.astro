---
import type { BlogFacets, Facet } from "../lib/blog";

interface Props {
  facets: BlogFacets;
  current: Facet;
}

const { facets, current } = Astro.props;

const isCurrent = (facet: Facet) => facet.kind === current.kind && facet.slug === current.slug;
const ariaCurrent = (facet: Facet) => (isCurrent(facet) ? "page" : undefined);

const applied = current.kind === "author" || current.kind === "year" ? current : undefined;
const appliedLabel = applied && `${applied.kind === "author" ? "Author" : "Year"}: ${applied.label}`;
const activeCount = current.kind === "all" ? 0 : 1;

const sections = [
  { title: "Category", items: [facets.all, ...facets.categories] },
  { title: "Author", items: facets.authors },
  { title: "Year", items: facets.years },
].filter((section) => section.items.length > 0);
---

<div class="blog-toolbar">
  <nav class="blog-chips" aria-label="Blog categories">
    {
      applied && (
        <a class="blog-chip is-applied" href="/blog/" aria-label={`Remove filter ${appliedLabel}`}>
          {appliedLabel}
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </a>
      )
    }
    {
      [facets.all, ...facets.categories].map((facet) => (
        <a class="blog-chip" href={facet.href} aria-current={ariaCurrent(facet)}>
          {facet.label}
          <span class="count">{facet.count}</span>
        </a>
      ))
    }
  </nav>
  <div class="blog-actions">
    <button type="button" class="blog-filters-button" commandfor="blog-filters" command="show-modal">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M4 6h16M7 12h10M10 18h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ></path>
      </svg>
      Filters
      {
        activeCount > 0 && (
          <span class="badge" aria-label={`${activeCount} active`}>
            {activeCount}
          </span>
        )
      }
    </button>
    <a class="blog-feed" href="/blog/feed.xml">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
        <circle cx="5" cy="19" r="1.5" fill="currentColor"></circle>
      </svg>
      <span>RSS</span>
    </a>
  </div>
</div>

<dialog id="blog-filters" class="blog-filters-drawer" closedby="any" aria-labelledby="blog-filters-title">
  <header class="drawer-header">
    <h2 id="blog-filters-title">Filter posts</h2>
    <button type="button" class="drawer-close" commandfor="blog-filters" command="close" aria-label="Close filters">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </header>
  <div class="drawer-body">
    {
      sections.map((section) => (
        <section>
          <h3>{section.title}</h3>
          <ul>
            {section.items.map((facet) => (
              <li>
                <a href={facet.href} aria-current={ariaCurrent(facet)}>
                  {facet.avatar && <img src={facet.avatar} alt="" width="24" height="24" loading="lazy" />}
                  <span class="label">{facet.label}</span>
                  <span class="count">{facet.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <footer class="drawer-footer">
    {activeCount > 0 ? <a href="/blog/">Clear filter</a> : <span></span>}
    <button type="button" class="drawer-done" commandfor="blog-filters" command="close">Done</button>
  </footer>
</dialog>

<script>
  if (!("commandForElement" in HTMLButtonElement.prototype)) {
    document.addEventListener("click", (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>("button[commandfor]");
      if (!button) return;
      const dialog = document.getElementById(button.getAttribute("commandfor") ?? "");
      if (!(dialog instanceof HTMLDialogElement)) return;
      const command = button.getAttribute("command");
      if (command === "show-modal") dialog.showModal();
      else if (command === "close") dialog.close();
    });
  }

  if (!("closedBy" in HTMLDialogElement.prototype)) {
    const dialog = document.getElementById("blog-filters") as HTMLDialogElement | null;
    dialog?.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      const inside =
        rect.top <= event.clientY &&
        event.clientY <= rect.bottom &&
        rect.left <= event.clientX &&
        event.clientX <= rect.right;
      if (!inside) dialog.close();
    });
  }
</script>

<style>
  .blog-toolbar {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 40px;
  }

  .blog-chips {
    display: flex;
    gap: 8px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .blog-chip {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid var(--light-grey-color);
    border-radius: 999px;
    color: var(--secondary-text-color);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .blog-chip .count {
    font-size: 12px;
    opacity: 0.7;
  }

  .blog-chip[aria-current="page"],
  .blog-chip.is-applied {
    border-color: var(--primary-color);
    background: var(--primary-color);
    color: var(--on-primary-color);
  }

  .blog-actions {
    display: flex;
    flex-shrink: 0;
    gap: 8px;
    margin-inline-start: auto;
  }

  .blog-filters-button,
  .blog-feed {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid var(--light-grey-color);
    border-radius: 999px;
    background: transparent;
    color: var(--primary-text-color);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .badge {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--primary-color);
    color: var(--on-primary-color);
    font-size: 12px;
  }

  @media (hover: hover) {
    .blog-chip:hover {
      border-color: var(--primary-color);
      color: var(--primary-text-color);
    }

    .blog-chip[aria-current="page"]:hover,
    .blog-chip.is-applied:hover {
      color: var(--on-primary-color);
    }

    .blog-filters-button:hover,
    .blog-feed:hover {
      border-color: var(--primary-color);
    }

    .drawer-close:hover {
      background: var(--light-grey-color);
    }

    .drawer-body a:hover {
      background: var(--light-grey-color);
    }
  }

  @media (max-width: 767px) {
    .blog-toolbar {
      flex-direction: column-reverse;
      flex-wrap: nowrap;
      align-items: stretch;
    }

    .blog-actions {
      margin-inline-start: 0;
    }

    .blog-filters-button {
      flex-grow: 1;
      justify-content: center;
    }

    .blog-feed span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  :global(html:has(#blog-filters[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .blog-filters-drawer {
    width: min(384px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--primary-background-color);
    color: var(--primary-text-color);
    overscroll-behavior: contain;
    box-shadow: 0 8px 24px rgba(9, 41, 59, 0.12);
    opacity: 0;
    transition-property: opacity, transform, display, overlay;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  .blog-filters-drawer[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;

    @starting-style {
      opacity: 0;
    }
  }

  .blog-filters-drawer::backdrop {
    background-color: rgb(9 41 59 / 0);
    transition-property: background-color, display, overlay;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  .blog-filters-drawer[open]::backdrop {
    background-color: rgb(9 41 59 / 0.5);

    @starting-style {
      background-color: rgb(9 41 59 / 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .blog-filters-drawer {
      transform: translateX(100%);
    }

    .blog-filters-drawer[open] {
      transform: none;

      @starting-style {
        transform: translateX(100%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-filters-drawer,
    .blog-filters-drawer::backdrop {
      transition-duration: 0.1s;
    }
  }

  @media (max-width: 767px) {
    .blog-filters-drawer {
      width: 100vw;
      height: auto;
      max-height: 85dvh;
      margin: auto 0 0;
      border-radius: 16px 16px 0 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .blog-filters-drawer {
        transform: translateY(100%);
      }

      .blog-filters-drawer[open] {
        transform: none;

        @starting-style {
          transform: translateY(100%);
        }
      }
    }
  }

  .drawer-header,
  .drawer-footer {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 24px;
  }

  .drawer-header {
    border-bottom: 1px solid var(--light-grey-color);
  }

  .drawer-header h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
  }

  .drawer-close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--primary-text-color);
    cursor: pointer;
  }

  .drawer-body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 8px 16px 24px;
  }

  .drawer-body section + section {
    margin-top: 16px;
  }

  .drawer-body h3 {
    margin: 16px 8px 8px;
    color: var(--grey-color);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .drawer-body ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drawer-body a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 8px;
    border-radius: 8px;
    color: var(--secondary-text-color);
    font-size: 15px;
    text-decoration: none;
  }

  .drawer-body a[aria-current="page"] {
    background: var(--primary-color);
    color: var(--on-primary-color);
    font-weight: 500;
  }

  .drawer-body img {
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    background: var(--light-grey-color);
  }

  .drawer-body .label {
    flex-grow: 1;
  }

  .drawer-body .count {
    font-size: 13px;
    opacity: 0.7;
  }

  .drawer-footer {
    border-top: 1px solid var(--light-grey-color);
  }

  .drawer-footer a {
    color: var(--primary-text-color);
    font-size: 14px;
    font-weight: 500;
  }

  .drawer-done {
    padding: 10px 24px;
    border: 0;
    border-radius: 999px;
    background: var(--primary-color);
    color: var(--on-primary-color);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
</style>
