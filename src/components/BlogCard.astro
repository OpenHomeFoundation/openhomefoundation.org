---
import Icon from "./Icon.astro";
import { cardImage, formatDate, postAuthors, postUrl, readingTime, truncate, type Post } from "../lib/blog";

interface Props {
  post: Post;
  /** The media room's news cards don't say where a crosspost is shared from. */
  badge?: boolean;
  /** Wide card for the newest post at the top of the blog archive. */
  featured?: boolean;
  headingLevel?: 2 | 3;
}

const { post, badge = true, featured = false, headingLevel = 2 } = Astro.props;
const { title, description, category, date, external_url, external_source } = post.data;
const Heading = `h${headingLevel}` as const;
const authors = postAuthors(post);
const source = external_url ? (badge ? `Shared from ${external_source}` : undefined) : `${readingTime(post)} minute read`;
const fallbackImage = "/assets/images/opengraph.jpg";
---

<a href={postUrl(post)} class:list={["blog-card", { "blog-card-featured": featured }]}>
  <div class="blog-card-image">
    <span class="blog-card-placeholder" aria-hidden="true">
      <Icon name="foundation" />
    </span>
    <img
      src={cardImage(post)}
      alt=""
      width="1200"
      height="630"
      loading={featured ? "eager" : "lazy"}
      fetchpriority={featured ? "high" : undefined}
      decoding="async"
      onload="this.parentNode.classList.add('loaded')"
      onerror={`this.onerror=null;this.src='${fallbackImage}'`}
    />
  </div>
  <div class="blog-card-content">
    <p class="blog-card-meta">
      {category && <span class="blog-card-category">{category}</span>}
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    </p>
    <Heading class="blog-card-title">{title}</Heading>
    {description && <p class="blog-card-description">{truncate(description, featured ? 260 : 140)}</p>}
    <div class="blog-card-footer">
      {
        authors.length > 0 && (
          <span class="blog-card-authors">
            <span class="blog-card-avatars">
              {authors.map((author) =>
                author.avatar ? (
                  <img src={author.avatar} alt="" width="24" height="24" loading="lazy" />
                ) : (
                  <span class="avatar-placeholder" aria-hidden="true" />
                ),
              )}
            </span>
            <span class="blog-card-author-names">{authors.map((author) => author.name).join(", ")}</span>
          </span>
        )
      }
      {source && <span class="blog-card-source">{source}</span>}
    </div>
  </div>
</a>
