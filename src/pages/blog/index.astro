---
import Base from "../../layouts/Base.astro";
import BlogListPage from "../../components/BlogListPage.astro";
import { getSortedPosts, POSTS_PER_PAGE } from "../../lib/blog";

const posts = await getSortedPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
---

<Base title="Blog" description="News and updates from the Open Home Foundation" canonicalUrl="/blog/">
  <BlogListPage posts={posts.slice(0, POSTS_PER_PAGE)} currentPage={1} totalPages={totalPages} />
</Base>
