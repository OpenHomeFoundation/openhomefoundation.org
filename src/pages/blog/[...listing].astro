---
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import BlogListPage from "../../components/BlogListPage.astro";
import { blogPageHref, getBlogListings } from "../../lib/blog";
import { SITE_URL } from "../../lib/site";

export function getStaticPaths() {
  return getBlogListings();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { listing } = Astro.props;
const { base, page, totalPages, title, description, noindex, breadcrumbs } = listing;
const isBlogHome = base === "/blog/" && page === 1;

const breadcrumbList = isBlogHome
  ? undefined
  : {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [{ name: "Home", href: "/" }, ...breadcrumbs, { name: title, href: Astro.url.pathname }].map(
        (crumb, i) => ({ "@type": "ListItem", position: i + 1, name: crumb.name, item: `${SITE_URL}${crumb.href}` }),
      ),
    };
---

<Base title={title} description={description} noindex={noindex} follow={noindex} jsonLd={breadcrumbList}>
  {page > 1 && <link slot="head" rel="prev" href={blogPageHref(page - 1, base)} />}
  {page < totalPages && <link slot="head" rel="next" href={blogPageHref(page + 1, base)} />}
  <BlogListPage listing={listing} showBreadcrumbs={!isBlogHome} />
</Base>
