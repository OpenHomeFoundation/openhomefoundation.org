---
import type { InferGetStaticPropsType } from "astro";
import Base from "../../layouts/Base.astro";
import BlogListPage from "../../components/BlogListPage.astro";
import { blogPageHref, getBlogListings } from "../../lib/blog";

export function getStaticPaths() {
  return getBlogListings();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { listing, facets } = Astro.props;
const { facet, page, totalPages } = listing;

const headings = {
  all: { title: "Blog", description: "News and updates from the Open Home Foundation" },
  category: { title: facet.label, description: `${facet.label} from the Open Home Foundation` },
  author: { title: `Posts by ${facet.label}`, description: `Open Home Foundation blog posts by ${facet.label}` },
  year: { title: `Posts from ${facet.label}`, description: `Open Home Foundation blog posts from ${facet.label}` },
};
const { title, description } = headings[facet.kind];
const pageTitle = page > 1 ? `${title} – Page ${page} of ${totalPages}` : title;
const pageDescription = page > 1 ? `${description}, page ${page}.` : `${description}.`;
---

<Base title={pageTitle} description={pageDescription}>
  {page > 1 && <link slot="head" rel="prev" href={blogPageHref(page - 1, facet.href)} />}
  {page < totalPages && <link slot="head" rel="next" href={blogPageHref(page + 1, facet.href)} />}
  <BlogListPage listing={listing} facets={facets} title={title} description={headings.all.description} />
</Base>
