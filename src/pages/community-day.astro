---
import Base from "../layouts/Base.astro";
import Hero from "../components/community-day/Hero.astro";
import WhatIsCommunityDay from "../components/community-day/WhatIsCommunityDay.astro";
import WhatsNew from "../components/community-day/WhatsNew.astro";
import FindAMeetup from "../components/community-day/FindAMeetup.astro";
import ReadyToJoin from "../components/community-day/ReadyToJoin.astro";
import Faqs from "../components/community-day/Faqs.astro";
---

<Base
  title="Community Day"
  description="Community Day returns on Saturday, November 7, 2026. Find—or host—a local meetup celebrating Home Assistant, ESPHome, Music Assistant, and the wider Open Home Foundation community."
>
  <Hero />
  <WhatIsCommunityDay />
  <WhatsNew />
  <FindAMeetup />
  <ReadyToJoin />
  <Faqs />
</Base>

<style lang="scss">
  :root {
    --title-color: #002332;
    --body-color: #4F606E;

    --accent-green: #41D09B;
    --accent-blue: #99DFFC;
  }

  body {
    color: var(--body-color);
    background-color: #F7F6F2;
  }

  :global(.heading) {
    color: var(--title-color);
    font-weight: 700;
  }

  :global(#hero) {
    margin-top: 4rem;
  }

  :global(h1),
  :global(.h1) {
    @include fluid(40, 66, $property: font-size);
  }

  :global(h2),
  :global(.h2) {
    @include fluid(32, 48, $property: font-size);
  }

  :global(.title-container) {
    display: flex;
    flex-direction: column;
    align-items: center;
    @include fluid(16, 32, $property: gap);
    text-align: center;
  }

  :global(.content-container p) {
    @include fluid(18, 24, $property: font-size);
    color: var(--body-color);
    font-weight: 400;
  }

  :global(.content-container .button),
  :global(.card .button) {
    text-transform: none;
  }

  :global(.button-container) {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  :global(.button) {
    padding-top: 0.6875rem;
    padding-right: 1.75rem;
    padding-bottom: 0.6875rem;
    font-size: 0.875rem;
    gap: 0.625rem;
  }

  :global(.button.button--secondary) {
    background-color: var(--accent-green);
    border-color: var(--accent-green);
    transition:
      border-color 150ms ease-in-out,
      background-color 150ms ease-in-out;

    &:hover {
      background-color: var(--title-color);
      border-color: var(--title-color);
      color: #ffffff;
    }
  }

  :global(.button.button--has-icon) {
    align-items: center;
    padding-left: 0.5rem;
    flex-wrap: nowrap;

    &:before {
      width: 1.5rem;
      height: 1.5rem;
      content: '';
      background-color: #ffffff;
      border-radius: 50%;
    }
  }
</style>