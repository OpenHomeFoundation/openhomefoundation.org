---
import Base from "../layouts/Base.astro";
import Hero from "../components/community-day/Hero.astro";
import WhatIsCommunityDay from "../components/community-day/WhatIsCommunityDay.astro";
import WhatsNew from "../components/community-day/WhatsNew.astro";
import FindAMeetup from "../components/community-day/FindAMeetup.astro";
import ReadyToJoin from "../components/community-day/ReadyToJoin.astro";
import Faqs from "../components/community-day/Faqs.astro";
---

<Base
  title="Community Day"
  description="Community Day returns on Saturday, November 7, 2026. Find—or host—a local meetup celebrating Home Assistant, ESPHome, Music Assistant, and the wider Open Home Foundation community."
>
  <Hero />
  <WhatIsCommunityDay />
  <WhatsNew />
  <FindAMeetup />
  <ReadyToJoin />
  <Faqs />
</Base>

<style lang="scss">
  :root {
    --title-color: #002332;
    --body-color: #4F606E;

    --accent-green: #41D09B;
    --accent-blue: #99DFFC;
  }

  body {
    color: var(--body-color);
  }

  :global(.heading) {
    color: var(--title-color);
  }

  :global(#hero) {
    margin-top: 4rem;
  }
</style>