---
// Temporary test bed for the Community Day social-asset generator. Once the
// component is signed off it moves onto /community-day/ itself; this page is
// noindex and excluded from the sitemap (see astro.config.mjs) until then.
import Base from "../../layouts/Base.astro";
import Section from "../../components/community-day/Section.astro";
import AssetGenerator from "../../components/community-day/AssetGenerator.astro";
---

<Base
  title="Community Day Asset Generator"
  description="Create a social graphic to announce your Community Day meetup."
  noindex
>
  <Section id="asset-generator">
    <div class="intro">
      <h1 class="heading">Meetup asset generator</h1>
      <p>
        Pick your project, set the date and city, and download a ready-to-post
        graphic to announce your Community Day meetup.
      </p>
    </div>
    <AssetGenerator />
  </Section>
</Base>

<style lang="scss">
  :root {
    --title-color: #002332;
    --body-color: #4f606e;
  }

  body {
    color: var(--body-color);
    background-color: #f7f6f2;
  }

  :global(#asset-generator) {
    margin: 4rem 0 6rem;
  }

  .intro {
    max-width: 720px;
    margin-bottom: 2.5rem;

    h1 {
      color: var(--title-color);
      font-weight: 700;
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    p {
      font-size: 1.25rem;
    }
  }
</style>
