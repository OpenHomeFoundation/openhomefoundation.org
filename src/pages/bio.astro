---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import bio from "../data/bio.yml";
import { cardImage, formatDate, getSortedPosts, postUrl } from "../lib/blog";

// The newest edition from the newsletter's RSS feed. If the feed can't be
// reached, the item keeps the details written in bio.yml.
async function latestNewsletter(fallback: { note: string; image: string }) {
  try {
    const response = await fetch("https://newsletter.openhomefoundation.org/rss/", {
      signal: AbortSignal.timeout(5000),
    });
    const item = (await response.text()).split("<item>")[1] ?? "";
    const pick = (pattern: RegExp) => item.match(pattern)?.[1];
    const title = pick(/<title><!\[CDATA\[(.*?)\]\]><\/title>/);
    const url = pick(/<link>(.*?)<\/link>/);
    const date = pick(/<pubDate>(.*?)<\/pubDate>/);
    // Ghost serves a resized WebP copy of any upload; the original is a large PNG.
    const image = pick(/<media:content url="(.*?)"/)?.replace("/content/images/", "/content/images/size/w1200/format/webp/");
    if (!title || !url) throw new Error("no edition in the feed");
    return {
      title,
      url,
      note: date ? `Newsletter · ${formatDate(new Date(date))}` : fallback.note,
      image: image ?? fallback.image,
    };
  } catch (error) {
    console.warn(`bio: using the fallback newsletter link (${(error as Error).message})`);
    return fallback;
  }
}

bio.latest = await Promise.all(
  bio.latest.map((item) => (item.feed === "newsletter" ? latestNewsletter(item) : item)),
);

const curated = new Set(bio.latest.map((item) => item.url));
const posts = (await getSortedPosts())
  .filter((post) => !post.data.external_url && !curated.has(postUrl(post)))
  .slice(0, 2)
  .map((post) => ({
    title: post.data.title,
    note: formatDate(post.data.date),
    url: postUrl(post),
    image: cardImage(post),
  }));
const latest = [...bio.latest, ...posts];
---

<Base title="Links" description={bio.tagline} noindex bare>
  <main id="bio">
    <div class="bio">
      <header class="bio-header">
        <h1><img src="/assets/images/logo/open-home-foundation.svg" alt="Open Home Foundation" width="240" height="54" /></h1>
        <p>{bio.tagline}</p>
      </header>

      <section>
        <h2>Latest</h2>
        <ul class="bio-posts">
          {latest.map((item) => (
            <li>
              <a href={item.url} class="bio-link bio-card">
                <img src={item.image} alt="" width="1200" height="630" />
                <span>
                  <strong>{item.title}</strong>
                  <small>{item.note}</small>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {bio.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <ul>
            {section.links.map((link) => (
              <li>
                <a href={link.url} class:list={["bio-link", { "bio-project": link.logo }, link.highlight && `bio-${link.highlight}`]}>
                  <span>
                    {link.logo ? <img src={link.logo} alt={link.label} height="28" /> : <strong>{link.label}</strong>}
                    {link.note && <small>{link.note}</small>}
                  </span>
                  <Icon name="arrow-small" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <nav class="bio-socials" aria-label="Open Home Foundation elsewhere">
        {bio.socials.map((social) => (
          <a href={social.url} aria-label={social.label} rel="me noopener" class="button button-icon button-outline">
            <Icon name={social.icon} />
          </a>
        ))}
      </nav>

      <p class="bio-footer"><a href="/">openhomefoundation.org</a></p>
    </div>
  </main>
</Base>
