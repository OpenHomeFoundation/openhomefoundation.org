---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { bio, bioPage } from "../lib/bio";
import { dataAttributes } from "../lib/bio-schedule.mjs";

const { latest, sections } = await bioPage();
---

<Base title="Links" description={bio.tagline} noindex bare>
  <main id="bio">
    <div class="bio">
      <header class="bio-header">
        <h1><img src="/assets/images/logo/open-home-foundation.svg" alt="Open Home Foundation" width="240" height="54" /></h1>
        <p>{bio.tagline}</p>
      </header>

      <section hidden={latest.hidden}>
        <h2>Latest</h2>
        <ul data-schedule data-limit={latest.limit}>
          {latest.entries.map((entry) => (
            <li hidden={entry.hidden} {...dataAttributes(entry)}>
              <a href={entry.url} class:list={["bio-link", entry.kind === "row" ? "bio-tile" : "bio-card"]}>
                {entry.kind === "video" ? (
                  <div class="bio-video">
                    <img src={entry.image} alt="" width="1200" height="630" loading="lazy" />
                    <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
                      <path
                        d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.6 8.6 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.6 8.6 0 0 0 6 6c5.3 1.4 26.5 1.4 26.5 1.4s21.2 0 26.5-1.4a8.6 8.6 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z"
                        fill="#f00"
                      />
                      <path d="M45 24 27 14v20Z" fill="#fff" />
                    </svg>
                  </div>
                ) : (
                  <img
                    src={entry.thumb?.path ?? entry.image}
                    alt=""
                    width="1200"
                    height="630"
                    loading={entry.kind === "hero" && !entry.hidden ? undefined : "lazy"}
                  />
                )}
                <span>
                  <strong>{entry.title}</strong>
                  <small>{entry.note}</small>
                </span>
                {entry.kind === "row" && <Icon name="arrow-small" />}
              </a>
            </li>
          ))}
        </ul>
      </section>

      {sections.map((section) => (
        <section hidden={section.hidden}>
          <h2>{section.title}</h2>
          <ul data-schedule>
            {section.entries.map((link) => (
              <li hidden={link.hidden} {...dataAttributes(link)}>
                <a href={link.url} class:list={["bio-link", { "bio-project": link.logo }, link.highlight && `bio-${link.highlight}`]}>
                  <span>
                    {link.logo ? <img src={link.logo} alt={link.label} height="28" /> : <strong>{link.label}</strong>}
                    {link.note && <small>{link.note}</small>}
                  </span>
                  <Icon name="arrow-small" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <nav class="bio-socials" aria-label="Open Home Foundation elsewhere">
        {bio.socials.map((social) => (
          <a href={social.url} aria-label={social.label} rel="me noopener" class="button button-icon button-outline">
            <Icon name={social.icon} />
          </a>
        ))}
      </nav>

      <p class="bio-footer"><a href="/">openhomefoundation.org</a></p>
    </div>
  </main>
</Base>

<script>
  import "../scripts/bio-schedule.js";
</script>
